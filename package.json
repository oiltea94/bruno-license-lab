{
  "name": "bruno-license-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stateless, device-bound client license helper",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "node scripts/wrangler.mjs dev --local",
    "dry-run": "node scripts/wrangler.mjs deploy --dry-run --outdir .dry-run",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
