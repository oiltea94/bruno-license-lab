{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bruno-license-lab",
  "main": "worker.mjs",
  "build": { "command": "node scripts/init-secrets.mjs" },
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false }
}
